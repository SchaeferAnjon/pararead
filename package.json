{
  "name": "pararead",
  "productName": "ParaRead",
  "version": "0.2.2",
  "private": true,
  "description": "读英文论文：重排成好读的版面、逐段对照翻译、划词解释、AI 问答",
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "ELECTRON_RUN_AS_NODE=1 electron node_modules/vitest/vitest.mjs run",
    "rebuild": "electron-builder install-app-deps",
    "dist": "electron-vite build && electron-builder --mac --arm64 --publish never -c.forceCodeSigning=true",
    "dist:dir": "electron-vite build && electron-builder --mac --arm64 --dir --publish never",
    "icon": "node scripts/icon.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "electron-updater": "^6.8.11",
    "fflate": "^0.8.3",
    "node-html-parser": "^9.0.5",
    "pdfjs-dist": "^6.4.299"
  },
  "devDependencies": {
    "@babel/parser": "7.29.14",
    "@babel/traverse": "7.29.14",
    "@cn/ai-chat": "workspace:*",
    "@cn/ai-engines": "workspace:*",
    "@cn/design": "workspace:*",
    "@cn/family": "workspace:*",
    "@cn/format": "workspace:*",
    "@cn/git": "workspace:*",
    "@cn/pdf-view": "workspace:*",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.2",
    "electron-builder": "26.18.0",
    "electron-vite": "^6.0.0",
    "katex": "^0.19.0",
    "lucide-react": "^1.57.0",
    "playwright": "1.65.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "author": "Jia Zonghan",
  "license": "GPL-3.0-or-later",
  "homepage": "https://pararead.us-cloud.uk",
  "packageManager": "pnpm@12.14.0",
  "repository": "github:SchaeferAnjon/pararead"
}
